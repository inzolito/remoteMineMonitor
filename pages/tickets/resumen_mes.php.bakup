                                    }
                                    .image-over-h1 img {
                                        position: absolute;
                                        top: -80px;
                                        left: 50%;
                                        transform: translateX(-50%);
                                        width: 200px;
                                        height: auto;
                                    }
                                }
                            </style>
                        `);

                        $(win.document.body).prepend(`
                        <div class="custom-title-container" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; text-align: center; page-break-after: always;">
